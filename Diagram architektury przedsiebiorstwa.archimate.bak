<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="(new model)" id="id-de089ef9a9d249c5a6804e5fc73be30d" version="5.0.0">
  <folder name="Strategy" id="id-a1210a79d16d4393b3f386651969177a" type="strategy"/>
  <folder name="Business" id="id-e052cd9ba16c40ce8066dadbc8a1211a" type="business"/>
  <folder name="Application" id="id-3a39efe5d7db457990f9e29ea1e2b5a7" type="application"/>
  <folder name="Technology &amp; Physical" id="id-0f233cff239342c1abf84ae12cafd12d" type="technology">
    <element xsi:type="archimate:Device" name="Komputer operatora" id="id-c68de823ecca4f1db7cf8f44c594bb56">
      <documentation>Stanowisko planisty i kierownika akcji, służące do obsługi panelu koordynacyjnego.</documentation>
    </element>
    <element xsi:type="archimate:Node" name="Środowisko serwerowe" id="id-ded766cf777e486ab557a35aec134b90">
      <documentation>Infrastruktura uruchamiająca usługi systemu SARA.</documentation>
    </element>
    <element xsi:type="archimate:Device" name="Radiotelefon" id="id-d10cbd4204024842b6447448a5556100">
      <documentation>Komunikacja głosowa pomiędzy podgrupami a sztabem.</documentation>
    </element>
    <element xsi:type="archimate:Device" name="Smartfon ratownika" id="id-ced6d39d05fc4ee0a98b13ea98842a8b">
      <documentation>Mobilne urządzenie wykorzystywane przez ratowników podczas akcji poszukiwawczej. Umożliwia określanie pozycji GPS, komunikację z systemem SARA, przeglądanie map oraz przesyłanie informacji o przebiegu działań.</documentation>
    </element>
    <element xsi:type="archimate:SystemSoftware" name="Android" id="id-774b64aa8aae4e3aa3f5e3220ac38692"/>
    <element xsi:type="archimate:SystemSoftware" name="Linux" id="id-b353228c0cb841f794b6e017d965b752">
      <documentation>Software	Środowisko umożliwiające uruchamianie usług serwerowych SARA. np. windows server / linux</documentation>
    </element>
    <element xsi:type="archimate:CommunicationNetwork" name="Sieć Internet" id="id-1cc562c0e95c40adb35a2fe9e97bec34">
      <documentation>Infrastruktura komunikacyjna umożliwiająca przesyłanie danych pomiędzy aplikacjami mobilnymi ratowników, panelem koordynacyjnym oraz serwerem SARA.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Usługa hostingu aplikacji" id="id-aaea00365c7945d8b31b365ee69cd84e">
      <documentation>Udostępnia środowisko do uruchomienia systemu SARA.</documentation>
    </element>
    <element xsi:type="archimate:TechnologyService" name="Usługa lokalizacji GPS" id="id-8b744e7e0fb7425e8e7a7245ff5c36c8"/>
    <element xsi:type="archimate:Node" name="Węzeł mobilny" id="id-c8deb1640ee34d89bc3892f5c2af9659"/>
    <element xsi:type="archimate:SystemSoftware" name="System zarządzania bazą danych" id="id-831627169a104bd295af30d7397aa393"/>
    <element xsi:type="archimate:Device" name="Kontroler drona" id="id-6698194bb8974533b0de463c6b1914d5">
      <documentation>Sterowanie dronem i odbieranie obrazu.</documentation>
    </element>
    <element xsi:type="archimate:Device" name="Dron poszukiwawczy" id="id-07b39210dc6240efa145e28d10760173">
      <documentation>Rozpoznanie terenu i wykonywanie zdjęć oraz nagrań.</documentation>
    </element>
    <element xsi:type="archimate:Artifact" name="Pakiet aplikacji mobilnej SARA" id="id-bc381b76c8dd47f19bc0c3df217017ff"/>
    <element xsi:type="archimate:Device" name="Device" id="id-f044cdb0097649979f1f862659f31b0a"/>
  </folder>
  <folder name="Motivation" id="id-d432c9bab04b474ea3b72934ef797941" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Ochotnicze grupy poszukiwawczo-ratownicze" id="id-efedc27fd5a444d096281c0ebee43fe6">
      <documentation>Organizacja ochotnicza realizująca działania poszukiwawczo-ratownicze, współpracująca z Policją. Wykorzystuje system SARA do planowania akcji, koordynowania podgrup terenowych, monitorowania lokalizacji ratowników i dokumentowania przebiegu poszukiwań.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Ograniczone zasoby GPR" id="id-890379facc06469c802f06f8e78e34b2">
      <documentation>Ochotnicze grupy dysponują ograniczonymi środkami finansowymi, sprzętowymi i ludzkimi.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Brak centralnego narzędzia koordynacji" id="id-b7b05ae1e21949d5b8880cda645d7731">
      <documentation>Informacje o przebiegu akcji i działaniach podgrup wymagają uporządkowania.</documentation>
    </element>
    <element xsi:type="archimate:Goal" name="Goal" id="id-bb1706a0de014821b0233dfb3ea6f0d5"/>
    <element xsi:type="archimate:Outcome" name="Outcome" id="id-be74df65eca646ec9362d33fd0445091"/>
    <element xsi:type="archimate:Stakeholder" name="Policja" id="id-471da6d746ba4a47be2fc47f716a60e4">
      <documentation>Podmiot przekazujący informacje o osobach zaginionych, współpracujący z GPR i odbierający dokumentację z akcji.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Zespół SARA" id="id-0707b09fcbb14144b93b5d9a78e32274">
      <documentation>Odpowiada za nadzór nad projektem, pozyskiwanie dotacji i podejmowanie decyzji dotyczących kierunku rozwoju.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Podmioty finansujące" id="id-861c8d3b9b71493f9f71cfbb313c0dc9">
      <documentation>Zapewniają środki finansowe na utrzymanie systemu.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Wolontariusze" id="id-bb4bb5bef72749ea81f46939c659aee4">
      <documentation>Rozwijają i utrzymują oprogramowanie SARA.</documentation>
    </element>
    <element xsi:type="archimate:Stakeholder" name="Stakeholder" id="id-27bf072d0a5340599876e8a07faa169f"/>
    <element xsi:type="archimate:Assessment" name="Ograniczona widoczność lokalizacji ratowników" id="id-959e9a7f79eb4f53bc6c27132966cb16">
      <documentation>Sztab potrzebuje bieżącej informacji o położeniu uczestników akcji.</documentation>
    </element>
    <element xsi:type="archimate:Assessment" name="Rozproszona dokumentacja akcji" id="id-30f511aad61c49228ef79c1541a47b86">
      <documentation>Dane GPS, zdjęcia, notatki i komunikaty muszą być gromadzone i porządkowane.</documentation>
    </element>
    <element xsi:type="archimate:Driver" name="Potrzeba koordynacji podgrup" id="id-58ffeecbe36948229f5998a072679b69"/>
    <element xsi:type="archimate:Driver" name="Konieczność dokumentowania działań" id="id-25889807c52a46f2a750a1946dccdb36"/>
    <element xsi:type="archimate:Driver" name="Potrzeba bieżącej informacji o sytuacji" id="id-120e0a6d2426445baee0150cbc7965b7"/>
  </folder>
